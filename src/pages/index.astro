---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import VisitSummary from '../components/VisitSummary.astro';
import Menu from '../components/Menu.astro';
import Concept from '../components/Concept.astro';
import Hours from '../components/Hours.astro';
import Access from '../components/Access.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Café Ouka — 代々木上原のコーヒーとお菓子"
  description="代々木上原のCafé Ouka。シングルオリジンのハンドドリップコーヒーと、毎朝仕込むお菓子をご用意しています。"
>
  <Header />
  <main id="main-content">
    <Hero />
    <VisitSummary />
    <Menu />
    <Concept />
    <Hours />
    <Access />
  </main>
  <Footer />
</Layout>
