---
import { Image } from 'astro:assets';
import menuCoffee from '../assets/menu-coffee.jpg';
import { MENU } from '../utils/menu';
import SectionHeading from './SectionHeading.astro';
---

<section id="menu" class="bg-canvas px-gutter py-section">
  <div class="mx-auto max-w-content">
    <div class="grid items-end gap-8 border-b border-strong pb-10 lg:grid-cols-[minmax(0,1fr)_minmax(28rem,1.05fr)]">
      <SectionHeading
        eyebrow="Menu"
        title="一杯とひと皿を、気分に合わせて。"
        description="シングルオリジンのコーヒーを中心に、お茶、季節の飲みもの、毎朝仕込む軽食とお菓子をご用意しています。"
      />
      <Image
        src={menuCoffee}
        alt="自然光の入る丸テーブルに置かれたコーヒーと焼き菓子"
        widths={[640, 960, 1400]}
        sizes="(min-width: 1024px) 48vw, 100vw"
        loading="lazy"
        class="aspect-[3/2] w-full rounded-lg object-cover object-[center_62%] shadow-md"
      />
    </div>

    <p class="mt-6 text-sm font-bold text-muted">価格はすべて税込表示です。</p>

    <div class="mt-12 space-y-14">
      {MENU.map((category) => (
        <section aria-labelledby={`menu-${category.name.replace(/\W+/g, '-').toLowerCase()}`}>
          <h3
            id={`menu-${category.name.replace(/\W+/g, '-').toLowerCase()}`}
            class="font-brand text-h3 font-semibold text-primary"
          >
            {category.name}
          </h3>
          <ul class="mt-5 grid border-b border-default md:grid-cols-2 md:gap-x-10">
            {category.items.map((item) => (
              <li class="grid grid-cols-[minmax(0,1fr)_auto] gap-5 border-t border-default py-5">
                <div>
                  <p class="font-heading text-base font-semibold text-primary">{item.name}</p>
                  <p class="mt-1 text-sm leading-relaxed text-muted">{item.desc}</p>
                </div>
                <p class="pt-0.5 font-brand text-base font-semibold text-accent">{item.price}</p>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <p class="mt-10 max-w-narrow text-sm leading-relaxed text-muted">
      アレルギーをお持ちの方はスタッフまでお申し付けください。季節限定メニューや、食材の状況により内容が変更になる場合があります。
    </p>
  </div>
</section>
