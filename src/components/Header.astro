<div class="sticky top-0 z-40">
  <header class="border-b border-default bg-surface shadow-sm">
    <div class="mx-auto flex min-h-16 max-w-content items-center justify-between px-gutter">
      <div class="flex items-center gap-5">
        <a href="#hero" class="inline-flex min-h-11 items-center font-brand text-2xl font-bold text-primary">
          Café <span class="ml-1 italic text-accent">Ouka</span>
        </a>
        <span class="hidden border-l border-default pl-5 text-[11px] font-bold uppercase tracking-label text-muted sm:block">
          Yoyogi-Uehara
        </span>
      </div>

      <nav aria-label="メインナビゲーション" class="hidden md:block">
        <ul class="flex items-center gap-8 text-sm font-bold text-secondary">
          <li><a href="#menu" class="py-3 underline-offset-8 hover:text-link hover:underline">メニュー</a></li>
          <li><a href="#concept" class="py-3 underline-offset-8 hover:text-link hover:underline">私たちについて</a></li>
          <li><a href="#hours" class="py-3 underline-offset-8 hover:text-link hover:underline">営業時間</a></li>
          <li>
            <a href="#access" class="inline-flex min-h-11 items-center rounded-md border border-strong px-4 transition-colors duration-base ease-standard hover:border-link hover:bg-subtle hover:text-link">
              アクセス
            </a>
          </li>
        </ul>
      </nav>

      <button
        id="menu-toggle"
        type="button"
        class="inline-flex min-h-11 min-w-11 flex-col items-center justify-center gap-1.5 rounded-md border border-default text-primary md:hidden"
        aria-label="メニューを開く"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <span class="block h-0.5 w-5 bg-current"></span>
        <span class="block h-0.5 w-5 bg-current"></span>
        <span class="block h-0.5 w-5 bg-current"></span>
      </button>
    </div>

    <nav id="mobile-menu" aria-label="モバイルナビゲーション" class="border-t border-default bg-surface px-gutter py-4 md:hidden" hidden>
      <ul class="divide-y divide-default font-heading text-lg font-semibold text-primary">
        <li><a href="#menu" class="flex min-h-12 items-center py-2">メニュー</a></li>
        <li><a href="#concept" class="flex min-h-12 items-center py-2">私たちについて</a></li>
        <li><a href="#hours" class="flex min-h-12 items-center py-2">営業時間</a></li>
        <li><a href="#access" class="flex min-h-12 items-center py-2">アクセス</a></li>
      </ul>
    </nav>
  </header>
</div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('#menu-toggle');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');

  const setMenuOpen = (open: boolean, returnFocus = false) => {
    if (!toggle || !menu) return;
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
    if (returnFocus) toggle.focus();
  };

  toggle?.addEventListener('click', () => {
    setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setMenuOpen(false, true);
    }
  });
</script>
