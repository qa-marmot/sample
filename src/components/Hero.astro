---
import { Image } from 'astro:assets';
import heroCoffee from '../assets/hero-coffee.jpg';
import ActionLink from './ActionLink.astro';
---

<section id="hero" class="relative isolate min-h-[clamp(40rem,86svh,54rem)] overflow-hidden bg-primary">
  <Image
    src={heroCoffee}
    alt=""
    widths={[640, 960, 1280, 1600, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-[68%_center] saturate-[.82] md:object-center"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-primary via-primary/75 to-primary/10"></div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-primary/65 via-transparent to-primary/10"></div>

  <div class="mx-auto flex min-h-[clamp(40rem,86svh,54rem)] max-w-content items-center px-gutter py-18">
    <div class="max-w-2xl border-l border-accent-soft/70 pl-5 text-inverse sm:pl-8">
      <p class="mb-4 text-xs font-bold uppercase tracking-label text-accent-soft">
        Yoyogi-Uehara / Coffee &amp; Sweets
      </p>
      <h1 class="font-brand text-h1 font-bold tracking-tight text-inverse">
        Café <span class="block italic text-accent-soft sm:inline">Ouka</span>
      </h1>
      <p class="mt-7 max-w-xl font-heading text-xl font-semibold leading-relaxed text-inverse sm:text-2xl">
        シングルオリジンのコーヒーと、<br class="hidden sm:block" />毎朝仕込むお菓子。
      </p>
      <p class="mt-3 max-w-lg text-base leading-relaxed text-inverse">
        静かに過ごせる一杯の時間を、代々木上原の日常に。
      </p>
      <div class="mt-9 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
        <ActionLink href="#menu">メニューを見る</ActionLink>
        <ActionLink href="#hours" variant="secondary" tone="dark">営業時間・アクセス</ActionLink>
      </div>
    </div>
  </div>
</section>
