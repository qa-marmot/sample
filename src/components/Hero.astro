---
---
<section id="hero" class="relative min-h-screen flex flex-col items-center justify-center overflow-hidden">

  <!-- 背景画像 (Unsplash: コーヒーのラテアート by Nathan Dumlao) -->
  <div class="absolute inset-0">
    <img
      src="https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=1920&q=80"
      alt=""
      class="w-full h-full object-cover"
      loading="eager"
    />
    <!-- グラデーションオーバーレイ -->
    <div class="absolute inset-0 bg-gradient-to-b from-espresso/75 via-espresso/60 to-espresso/80"></div>
  </div>

  <!-- コンテンツ -->
  <div class="relative text-center px-6 max-w-3xl mx-auto">

    <!-- Eyebrow -->
    <p class="font-sans text-xs tracking-[0.35em] uppercase text-latte/80 mb-8 animate-[fadeUp_0.8s_ease_0.1s_both]">
      Since 2018 &ensp;—&ensp; 東京・代々木上原
    </p>

    <!-- Main heading -->
    <h1 class="font-display text-6xl sm:text-7xl md:text-8xl font-bold text-cream leading-[0.92] mb-6 animate-[fadeUp_0.8s_ease_0.3s_both]">
      Café<br/><span class="italic text-latte">Ouka</span>
    </h1>

    <!-- Decorative rule -->
    <div class="flex items-center justify-center gap-4 mb-8 animate-[fadeUp_0.8s_ease_0.4s_both]">
      <div class="h-px w-20 bg-latte/50"></div>
      <span class="text-latte text-base">✦</span>
      <div class="h-px w-20 bg-latte/50"></div>
    </div>

    <!-- Tagline -->
    <p class="font-serif text-xl sm:text-2xl text-cream/80 italic mb-12 animate-[fadeUp_0.8s_ease_0.5s_both]">
      落ち着いた時間を、あなたに。
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center animate-[fadeUp_0.8s_ease_0.6s_both]">
      <a href="#menu"
        class="px-9 py-4 bg-latte text-espresso font-sans font-medium text-sm tracking-widest uppercase rounded-full hover:bg-gold transition-colors duration-300">
        メニューを見る
      </a>
      <a href="#access"
        class="px-9 py-4 border border-cream/40 text-cream font-sans font-medium text-sm tracking-widest uppercase rounded-full hover:border-latte hover:text-latte transition-colors duration-300">
        アクセス
      </a>
    </div>
  </div>

  <!-- スクロールヒント -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-[fadeUp_1s_ease_1.2s_both]">
    <span class="text-[10px] text-cream/40 tracking-[0.3em] uppercase font-sans">Scroll</span>
    <div class="w-px h-12 bg-gradient-to-b from-latte/50 to-transparent"></div>
  </div>

</section>

<style>
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24px); }
  to   { opacity: 1; transform: none; }
}
</style>
