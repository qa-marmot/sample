---
import { HOURS, getTodayIndexForTimeZone } from '../utils/hours';
import SectionHeading from './SectionHeading.astro';

const todayIndex = getTodayIndexForTimeZone(new Date(), 'Asia/Tokyo');
---

<section id="hours" class="theme-inverse bg-ink px-gutter py-section text-inverse">
  <div class="mx-auto grid max-w-content gap-12 lg:grid-cols-[.8fr_1.2fr] lg:gap-20">
    <div>
      <SectionHeading
        eyebrow="Opening Hours"
        title="営業時間"
        tone="dark"
        description="曜日によって閉店時刻が異なります。ご来店前に当日の時間をご確認ください。"
      />
      <p class="mt-7 border-l-2 border-accent-soft pl-4 text-sm leading-relaxed text-accent-soft">
        ラストオーダーは閉店30分前です。<br />年末年始・お盆期間は営業時間が変わる場合があります。
      </p>
    </div>

    <div class="border-b border-accent-soft">
      {HOURS.map((row, index) => {
        const isToday = index === todayIndex;
        return (
          <div
            class:list={[
              'grid grid-cols-[minmax(0,1fr)_auto] items-center gap-5 border-t py-4 sm:px-5',
              isToday ? 'border-l-4 border-accent-soft bg-white/5 pl-4' : 'border-accent-soft',
            ]}
            aria-current={isToday ? 'date' : undefined}
          >
            <div class="flex flex-wrap items-center gap-3">
              <span class:list={['font-semibold', row.closed ? 'text-accent-soft line-through' : 'text-inverse']}>
                {row.day}
              </span>
              {isToday && (
                <span class="rounded-full border border-accent-soft px-2.5 py-0.5 text-xs font-bold text-accent-soft">
                  本日
                </span>
              )}
            </div>
            <span class:list={['font-brand font-semibold', row.closed ? 'text-accent-soft' : 'text-inverse']}>
              {row.time}
            </span>
          </div>
        );
      })}
    </div>
  </div>
</section>
