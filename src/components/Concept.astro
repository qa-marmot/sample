---
import { Image } from 'astro:assets';
import cafeInterior from '../assets/cafe-interior.jpg';
import SectionHeading from './SectionHeading.astro';

const points = [
  { title: '豆の産地にこだわる', body: '世界各地のシングルオリジン豆を毎月セレクト。' },
  { title: '静かで心地よい空間', body: '木と真鍮で仕上げた、落ち着いて過ごせる店内。' },
  { title: '丁寧なハンドドリップ', body: '温度と時間を管理し、バリスタが一杯ずつ抽出。' },
];
---

<section id="concept" class="bg-subtle px-gutter py-section">
  <div class="mx-auto grid max-w-content items-center gap-12 lg:grid-cols-[1.05fr_.95fr] lg:gap-16">
    <Image
      src={cafeInterior}
      alt="自然光が差し込む店内に並ぶ木のテーブルと椅子"
      widths={[640, 960, 1200]}
      sizes="(min-width: 1024px) 52vw, 100vw"
      loading="lazy"
      class="aspect-[4/3] w-full rounded-lg object-cover object-center shadow-md saturate-[.84]"
    />

    <div>
      <SectionHeading
        eyebrow="Our Story"
        title="日常の中に、特別な一杯を。"
        description="Café Oukaは、ゆっくりと流れる時間を大切にする小さなカフェです。朝の一杯から一日の終わりまで、その日の気分に寄り添うコーヒーとお菓子を用意しています。"
      />
      <ul class="mt-9 border-b border-strong">
        {points.map((point, index) => (
          <li class="grid gap-2 border-t border-strong py-5 sm:grid-cols-[2.5rem_minmax(0,1fr)] sm:gap-5">
            <span class="font-brand text-lg font-semibold text-accent" aria-hidden="true">0{index + 1}</span>
            <div>
              <h3 class="font-heading text-lg font-semibold text-primary">{point.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-secondary">{point.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
