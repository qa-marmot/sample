---
import SectionHeading from './SectionHeading.astro';

const mapEmbedUrl = 'https://www.google.com/maps?q=%E6%9D%B1%E4%BA%AC%E9%83%BD%E6%B8%8B%E8%B0%B7%E5%8C%BA%E4%B8%8A%E5%8E%9F1%E4%B8%81%E7%9B%AE26-5&output=embed';
const mapLinkUrl = 'https://www.google.com/maps/search/?api=1&query=%E6%9D%B1%E4%BA%AC%E9%83%BD%E6%B8%8B%E8%B0%B7%E5%8C%BA%E4%B8%8A%E5%8E%9F1%E4%B8%81%E7%9B%AE26-5';
---

<section id="access" class="bg-canvas px-gutter py-section">
  <div class="mx-auto max-w-content">
    <SectionHeading
      eyebrow="Access"
      title="代々木上原駅から、歩いて5分。"
      description="北口1から上原一丁目方面へ。駅前の賑わいを抜けた、静かな通りにあります。"
    />

    <div class="mt-12 grid gap-12 lg:grid-cols-[.85fr_1.15fr] lg:gap-16">
      <dl class="border-b border-strong">
        <div class="border-t border-strong py-6">
          <dt class="text-xs font-bold uppercase tracking-label text-accent">住所</dt>
          <dd class="mt-2 font-heading text-base leading-relaxed text-primary">
            〒151-0064<br />東京都渋谷区上原1丁目26-5
          </dd>
        </div>

        <div class="border-t border-strong py-6">
          <dt class="text-xs font-bold uppercase tracking-label text-accent">電車でのアクセス</dt>
          <dd class="mt-2 text-base leading-relaxed text-secondary">
            小田急線・千代田線「代々木上原駅」北口1から徒歩5分
          </dd>
          <dd class="mt-1 text-sm text-muted">上原一丁目方面へお進みください。</dd>
        </div>

        <div class="border-t border-strong py-6">
          <dt class="text-xs font-bold uppercase tracking-label text-accent">定休日</dt>
          <dd class="mt-2 font-heading text-lg font-semibold text-primary">毎週月曜日</dd>
          <dd class="mt-1 text-sm text-muted">祝日・季節休業は営業時間をご確認ください。</dd>
        </div>
      </dl>

      <div class="overflow-hidden rounded-lg border border-strong bg-surface shadow-md">
        <div class="aspect-[4/3] bg-subtle">
          <iframe
            src={mapEmbedUrl}
            title="Café Ouka周辺の地図"
            class="h-full w-full border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-3 border-t border-default px-5 py-4">
          <div>
            <p class="font-heading text-base font-semibold text-primary">Café Ouka</p>
            <p class="text-sm text-muted">代々木上原駅 北口1より徒歩5分</p>
          </div>
          <a
            href={mapLinkUrl}
            target="_blank"
            rel="noreferrer"
            class="inline-flex min-h-11 items-center font-bold text-link underline decoration-default underline-offset-4 transition-colors duration-base ease-standard hover:decoration-link"
          >
            Google Mapsで開く<span class="ml-1" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
